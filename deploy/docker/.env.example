# Public hostname of the existing 443 website. Telegram clients always connect
# to this hostname; the relay is never addressed directly.
TPROXY_HOSTNAME=xxx.com

# Relay path prefix. Default is proxy, so the bridge lives at
# https://xxx.com/proxy/?bridge=<capability>. Set an empty value for the root.
TPROXY_BASE_PATH=proxy

# MTProxy secret: 32 lowercase hex characters, optionally prefixed with dd.
TPROXY_SECRET=

# Host port published on 127.0.0.1 only, plain HTTP with no TLS. Point nginx
# `location ^~ /proxy/` at http://127.0.0.1:65501; nginx keeps the 443
# certificate.
TPROXY_HOST_PORT=65501

# Image reference. Leave the default to build locally with
# `docker compose up -d --build`; set the published image to pull instead:
#   TPROXY_IMAGE=ghcr.io/<owner>/<repo>:latest
#   docker compose pull && docker compose up -d
TPROXY_IMAGE=tproxy-server:local
TPROXY_PULL_POLICY=missing

# Operator website mirror served for unauthenticated requests under the prefix.
# It must answer like the real site, including its 404 page.
TPROXY_SITE_DIR=./site
TPROXY_PUBLIC_DIR=/srv/site

# Optional: use a loopback-reachable web application instead of the mirror.
# TPROXY_PUBLIC_UPSTREAM=http://172.17.0.1:3000

# Optional: the public address a Telegram middle-end sees. Without it the
# entrypoint probes echo services; behind 1:1 NAT, set it explicitly.
# MTPROXY_PUBLIC_IP=203.0.113.7

# Optional: container-local address used for --nat-info detection.
# MTPROXY_LOCAL_IP=172.17.0.2

# Optional tuning.
# MTPROXY_WORKERS=1
# MTPROXY_MAX_CONNECTIONS=4096
# MTPROXY_STATS_PORT=8888
# TPROXY_CARRIER_MODE=https
